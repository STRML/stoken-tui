#!/usr/bin/env python3
"""stoken-tui: a TOTP-app-like console view over stoken (RSA SecurID software tokens).

The seed is the only secret. It lives in the macOS Keychain (one item per alias) and reaches stoken
on a pipe, so no token file, password or temp file ever exists. ~/.stoken holds only a list of alias
names. Design and failure matrix: docs/plan.md.
"""
import argparse
import concurrent.futures
import contextlib
import fcntl
import getpass
import hashlib
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tempfile
import tty
import urllib.parse
from dataclasses import dataclass
from typing import Optional

SERVICE = os.environ.get("STOKEN_TUI_SERVICE", "stoken-tui")
SECURITY = os.environ.get("STOKEN_TUI_SECURITY", "/usr/bin/security")
NAME_BODY = r"[A-Za-z0-9](?:[A-Za-z0-9._ -]{0,62}[A-Za-z0-9._-])?"
ALIAS_RE = re.compile("^" + NAME_BODY + "$")
SERVICE_RE = re.compile(r"^[A-Za-z0-9._-]{1,128}$")
ACCOUNT_RE = re.compile("^" + NAME_BODY + r"(\.trashed-\d+)?$")
SEED_RE = re.compile(r"^\d{81}$")
CALL_TIMEOUT = 8
KEYCHAIN_TIMEOUT = float(os.environ.get("STOKEN_TUI_KEYCHAIN_TIMEOUT", "30"))
CLIPBOARD_SECONDS = 30
RETRY_SECONDS = 5
KEYCHAIN_NOT_FOUND = 44
MAX_TOKEN_BYTES = 32000
BAR_WIDTH = 10
GATED_COMMANDS = (None, "code", "export")
CTKIP_LINK_RE = re.compile(r"^com\.rsa\.securid(\.iphone)?://ctkip\b", re.I)
ACTIVATION_CODE_RE = re.compile(r"^[A-Za-z0-9]{4,40}$")
HOSTNAME_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$")
HEX_RUN_RE = re.compile(r"\b[0-9a-fA-F]{32}\b")
NO_SHEBANG_INTERPRETERS = ("sh", "bash", "zsh", "dash", "env")
NAME_PROMPT = "Name for this token: "
TOKEN_PROMPT = "Token (paste a link or string, or give an .sdtid path; hidden): "
PIN_PROMPT = "PIN (Enter if the token has none): "
PROMPT_TRIES = 3
TOUCH_ID_REASON = "unlock your SecurID tokens"
HELPER_SOURCE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "touchid.swift")


class Fail(Exception):
    exit_code = 1


class Usage(Fail):
    exit_code = 2


class KeychainUnavailable(Exception):
    def __init__(self, status):
        super().__init__("Keychain unavailable (exit %d)" % status)
        self.status = status


@dataclass
class Row:
    alias: str
    code: Optional[str] = None
    next_code: Optional[str] = None
    interval: int = 60
    error: Optional[str] = None
    window: int = -1
    fetched_at: float = 0.0


# Alias index ------------------------------------------------------------------------------------
# A plain list of alias names (no secrets), because the Keychain cannot list items by service.

def token_dir():
    return os.path.expanduser(os.environ.get("STOKEN_TUI_DIR", "~/.stoken"))


def cache_path():
    return os.path.expanduser(os.environ.get("STOKEN_TUI_CACHE", "~/.cache/stoken-tui"))


def cache_dir():
    path = cache_path()
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def ensure_token_dir():
    path = token_dir()
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def check_alias(alias):
    if not ALIAS_RE.fullmatch(alias or ""):
        raise Usage("alias must match [A-Za-z0-9][A-Za-z0-9._ -]{0,62}[A-Za-z0-9._-] (letters, digits, . _ - and spaces "
                    "inside, 64 characters at most): %r" % alias)


def need_stoken():
    if not shutil.which("stoken"):
        raise Usage("stoken not found on PATH (brew install stoken)")


def list_aliases():
    try:
        with open(os.path.join(token_dir(), "index")) as f:
            names = f.read().split("\n")
    except FileNotFoundError:
        return []
    return sorted({n for n in names if ALIAS_RE.fullmatch(n)})


@contextlib.contextmanager
def locked_index():
    """Serialize read-modify-write of the index across concurrent runs; yield its current aliases."""
    ensure_token_dir()
    lock = open(os.path.join(token_dir(), ".lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield list_aliases()
    finally:
        lock.close()


def write_index(aliases):
    path = os.path.join(token_dir(), "index")
    partial = "%s.tmp-%d" % (path, os.getpid())
    try:
        with open(partial, "w") as f:
            f.write("".join(a + "\n" for a in sorted(set(aliases))))
        os.replace(partial, path)
    finally:
        unlink_quiet(partial)


def unlink_quiet(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


# stoken ---------------------------------------------------------------------------------------

def call_stoken(args, stdin_text="", seed=None, option="--file"):
    """Run stoken. A seed travels on a pipe file descriptor, never in argv, a file or the environment."""
    if seed is None:
        return run_stoken(args, stdin_text, ())
    read_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, (seed + "\n").encode())
        os.close(write_fd)
        return run_stoken([*args, "%s=/dev/fd/%d" % (option, read_fd)], stdin_text, (read_fd,))
    finally:
        os.close(read_fd)


def run_stoken(args, stdin_text, pass_fds):
    try:
        return subprocess.run(["stoken", *args], input=stdin_text, capture_output=True, text=True,
                              errors="replace", timeout=CALL_TIMEOUT, pass_fds=pass_fds)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timed out")


def first_line(text):
    lines = [ln for ln in text.strip().splitlines() if ln.strip()]
    return lines[-1].strip() if lines else "stoken failed"


def interval_of(shown):
    m = re.search(r"Seconds per tokencode\s*:\s*(\d+)", shown)
    return int(m.group(1)) if m else 60


def classify_failure(res):
    text = res.stdout + "\n" + res.stderr
    if res.returncode == 124:
        return "timed out"
    if "PIN must be" in text or "only allows one prompt" in text:
        return "PIN required"
    if "garbled" in text or "no token present" in text or "no valid token" in text:
        return "seed unreadable"
    return first_line(res.stderr or res.stdout)


def normalize_seed(raw):
    """Turn an sdtid file, CTF string or activation link into stoken's plain 81-digit string."""
    if len(raw.encode()) > MAX_TOKEN_BYTES:
        raise Fail("that is too large to be a token")
    res = call_stoken(["export", "--batch"], seed=raw)
    seed = res.stdout.strip()
    if res.returncode != 0 or not SEED_RE.fullmatch(seed):
        raise Fail("not a usable token: " + first_line(res.stderr or res.stdout))
    return seed


# CT-KIP provisioning ----------------------------------------------------------------------------
# An activation link holds a one-time code and a server URL, not a seed. rsa_ct_kip's client trades the
# code for a seed. The server commits the token before we hold it, so every path below either keeps a
# recovery copy or knows there is nothing to keep. Design and failure matrix: docs/plan.md.

TEMPLATE_NAME = "template.xml"
RECOVERY_NAME = "recovery.sdtid"
OUTPUT_NAME = "helper-output.txt"
CTKIP_STUB = """import sys
from rsa_ct_kip import client
code = sys.stdin.readline().strip()
make_session = client.requests.session


def closing_session():
    session = make_session()
    session.headers["Connection"] = "close"
    return session


client.requests.session = closing_session
client.stoken = None
client.main(sys.argv[1:2] + [code] + sys.argv[2:3])
"""


@dataclass
class HelperResult:
    returncode: Optional[int] = None
    stdout: str = ""
    stderr: str = ""
    timed_out: bool = False


def one_value(query, name):
    values = query.get(name, [])
    if len(values) != 1 or not values[0]:
        raise Fail("the activation link needs exactly one %s" % name)
    return values[0]


def check_ctkip_url(url):
    parts = urllib.parse.urlsplit(url)
    if re.search(r"[\s\x00-\x1f\x7f]", url):
        raise Fail("the url in the activation link has whitespace or control characters in it")
    if parts.scheme != "https" or not parts.hostname or not HOSTNAME_RE.fullmatch(parts.hostname):
        raise Fail("the url in the activation link must be an https address")
    if parts.username is not None or parts.password is not None:
        raise Fail("the url in the activation link must not carry a user name or password")
    return url


def parse_ctkip_link(text):
    """Return (url, activation code) for a CT-KIP activation link, or None for any other text."""
    link = text.strip()
    if not CTKIP_LINK_RE.match(link):
        return None
    if re.search(r"[\s\x00-\x1f\x7f]", link):
        raise Fail("the activation link has whitespace or control characters in it")
    query = urllib.parse.parse_qs(urllib.parse.urlsplit(link).query, keep_blank_values=True)
    code = one_value(query, "activationCode")
    if not ACTIVATION_CODE_RE.fullmatch(code):
        raise Fail("the activation code must be 4 to 40 letters and digits")
    return check_ctkip_url(one_value(query, "url")), code


def find_helper():
    """Return the Python that runs rsa_ct_kip, taken from the script's shebang line."""
    path = os.environ.get("STOKEN_TUI_CTKIP") or shutil.which("rsa_ct_kip")
    if not path or not os.path.isfile(path) or not os.access(path, os.X_OK):
        raise Usage("rsa_ct_kip not found: install it with `pip install rsa-ct-kip`, or set STOKEN_TUI_CTKIP to the script")
    with open(path, "rb") as f:
        first = f.readline(512).decode(errors="replace").strip()
    found = re.fullmatch(r"#!\s*(/\S+)", first)
    interpreter = found.group(1) if found else None
    if not interpreter or os.path.basename(interpreter) in NO_SHEBANG_INTERPRETERS or not os.access(interpreter, os.X_OK):
        raise Usage("cannot tell which Python runs %s (its first line must name one by absolute path): "
                    "set STOKEN_TUI_CTKIP to a pip-installed rsa_ct_kip script" % path)
    return interpreter


def ctkip_timeout():
    return float(os.environ.get("STOKEN_TUI_CTKIP_TIMEOUT", "60"))


def stop_group(proc):
    with contextlib.suppress(ProcessLookupError, PermissionError):
        os.killpg(proc.pid, signal.SIGKILL)
    try:
        return proc.communicate(timeout=5)
    except Exception:
        return "", ""


def run_helper(interpreter, url, code, workdir, result):
    """Run the client in its own session, with the code on stdin. Anything that stops us kills the group."""
    environment = {k: v for k, v in os.environ.items() if k not in ("STOKEN_TUI_PIN", "STOKEN_TUI_PASSWORD")}
    environment["TMPDIR"] = workdir
    proc = subprocess.Popen([interpreter, "-u", "-I", "-c", CTKIP_STUB, url, os.path.join(workdir, TEMPLATE_NAME)],
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                            errors="replace", env=environment, start_new_session=True)
    try:
        result.stdout, result.stderr = proc.communicate(code + "\n", timeout=ctkip_timeout())
        result.returncode = proc.returncode
    except subprocess.TimeoutExpired:
        result.stdout, result.stderr = stop_group(proc)
        result.timed_out = True
    except BaseException:
        result.stdout, result.stderr = stop_group(proc)
        raise


def phase_note(stdout):
    if "Token seed:" in stdout:
        return "The server issued the token, so the activation code is spent."
    if "Sending ServerFinished request" in stdout:
        return "The server may already have issued the token, so the activation code may already be spent."
    return "The server had not issued a token, so the activation code is probably still unspent."


def scrub(text, code):
    return HEX_RUN_RE.sub("***", text.replace(code, "***"))


def fix_template(template):
    """rsa_ct_kip writes DefAddPin, which stoken ignores; a PINless token also needs DefLocalPIN 0."""
    fixed = template.replace("DefAddPin>", "DefAddPIN>")
    if "<DefLocalPIN>" not in fixed and "<DefAddPIN>0</DefAddPIN>" in fixed:
        fixed = fixed.replace("</DefAddPIN>", "</DefAddPIN><DefLocalPIN>0</DefLocalPIN>", 1)
    return fixed


def sdtid_from_template(template):
    res = call_stoken(["export", "--random", "--sdtid"], seed=fix_template(template), option="--template")
    if res.returncode != 0 or "<" not in res.stdout:
        raise Fail("stoken could not build a token from the issued template: " + first_line(res.stderr or res.stdout))
    return res.stdout


def write_private(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)


def read_if_any(path):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except FileNotFoundError:
        return ""


def seed_from_run(workdir, result, code):
    note = phase_note(result.stdout)
    if result.timed_out:
        raise Fail("rsa_ct_kip timed out after %g s. %s" % (ctkip_timeout(), note))
    if result.returncode != 0:
        cause = scrub(first_line(result.stderr), code) if result.stderr.strip() else "no error text"
        raise Fail("rsa_ct_kip failed: %s. %s" % (cause, note))
    if "MAC verified" not in result.stdout or "MAC not verified" in result.stdout:
        raise Fail("the server's MAC did not verify, so the token was discarded. Ask the issuer for a new link.")
    template_path = os.path.join(workdir, TEMPLATE_NAME)
    template = read_if_any(template_path).strip()
    if not template:
        raise Fail("rsa_ct_kip finished without writing a token. " + note)
    sdtid = sdtid_from_template(template)
    write_private(os.path.join(workdir, RECOVERY_NAME), sdtid)
    unlink_quiet(template_path)
    return normalize_seed(sdtid)


def save_recovery(workdir, template, stdout):
    template_path = os.path.join(workdir, TEMPLATE_NAME)
    recovery = os.path.join(workdir, RECOVERY_NAME)
    if template and not os.path.exists(recovery):
        with contextlib.suppress(Fail):
            write_private(recovery, sdtid_from_template(template))
    if os.path.exists(recovery):
        unlink_quiet(template_path)
        return
    if not template:
        unlink_quiet(template_path)
    write_private(os.path.join(workdir, OUTPUT_NAME), stdout)


def note_kept(workdir):
    print("The server has issued this token, so its one-time code is spent. A recovery copy is kept in %s (mode 0700): %s."
          % (workdir, ", ".join(sorted(os.listdir(workdir)))), file=sys.stderr)
    print("For recovery.sdtid, run `stoken-tui add NAME --file %s`, and trash the directory once the token works."
          % os.path.join(workdir, RECOVERY_NAME), file=sys.stderr)


def settle_run_dir(workdir, result):
    """Delete the run directory unless the server may have issued a token; then keep a recovery copy in it."""
    template = read_if_any(os.path.join(workdir, TEMPLATE_NAME)).strip()
    committed = bool(template) or "Token seed:" in result.stdout
    if not committed or "MAC not verified" in result.stdout:
        shutil.rmtree(workdir, ignore_errors=True)
        return
    with contextlib.suppress(Exception):
        save_recovery(workdir, template, result.stdout)
    note_kept(workdir)


def provision_ctkip(url, code, interpreter):
    """Return (run directory, 81-digit seed). The directory holds recovery.sdtid until the caller deletes it."""
    workdir = tempfile.mkdtemp(prefix="ctkip-", dir=cache_dir())
    result = HelperResult()
    try:
        run_helper(interpreter, url, code, workdir, result)
        return workdir, seed_from_run(workdir, result, code)
    except BaseException:
        settle_run_dir(workdir, result)
        raise


# Keychain -------------------------------------------------------------------------------------
# Seeds live under SERVICE, PINs under SERVICE + ".pin"; the account is the alias.

def service_name(pin):
    return SERVICE + (".pin" if pin else "")


def keychain(args, stdin_text=None):
    if not SERVICE_RE.fullmatch(SERVICE):
        raise Usage("STOKEN_TUI_SERVICE has characters outside [A-Za-z0-9._-]")
    try:
        return subprocess.run([SECURITY, *args], input=stdin_text, capture_output=True, text=True,
                              errors="replace", timeout=KEYCHAIN_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise KeychainUnavailable(124)


def kc_get(account, pin=False):
    res = keychain(["find-generic-password", "-s", service_name(pin), "-a", account, "-w"])
    if res.returncode == 0:
        return res.stdout[:-1] if res.stdout.endswith("\n") else res.stdout
    if res.returncode == KEYCHAIN_NOT_FOUND:
        return None
    raise KeychainUnavailable(res.returncode)


def kc_put(account, value, pin=False):
    """Store a value, then read it back: `security -i` can exit 0 without storing anything."""
    if not ACCOUNT_RE.fullmatch(account):
        raise Usage("bad Keychain account name: %r" % account)
    line = 'add-generic-password -s "%s" -a "%s" -X %s\n' % (service_name(pin), account, value.encode().hex())
    res = keychain(["-i"], line)
    if res.returncode != 0:
        raise Fail("Keychain write failed (exit %d): %s" % (res.returncode, res.stderr.strip()))
    if kc_get(account, pin) != value:
        raise Fail("Keychain write did not stick for account %s" % account)


def kc_delete(account, pin=False):
    keychain(["delete-generic-password", "-s", service_name(pin), "-a", account])


# Reading codes ----------------------------------------------------------------------------------

def fetch_row(alias, now, use_time=None):
    try:
        return read_row(alias, now, use_time)
    except Exception as e:
        return Row(alias, error=first_line(str(e)), fetched_at=now)


def read_row(alias, now, use_time=None):
    row = Row(alias, fetched_at=now)
    try:
        seed, pin = kc_get(alias), kc_get(alias, pin=True)
    except KeychainUnavailable as e:
        row.error = str(e)
        return row
    if seed is None:
        row.error = "no seed in Keychain"
        return row
    row.interval = interval_of(call_stoken(["show", "--batch"], seed=seed).stdout)
    when = int(use_time or time.time())
    row.window = when // row.interval
    codes = []
    for offset in (0, row.interval):
        res = call_stoken(["tokencode", "--batch", "--stdin", "--use-time=%d" % (when + offset)], (pin or "") + "\n", seed)
        if res.returncode != 0 or not res.stdout.strip().isdigit():
            row.error = classify_failure(res)
            return row
        codes.append(res.stdout.strip())
    row.code, row.next_code = codes
    return row


def fetch_all(aliases, now, use_time=None):
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(lambda a: fetch_row(a, now, use_time), aliases))


def seconds_left(row, now):
    return row.interval - int(now) % row.interval


def format_code(code):
    if len(code) in (6, 8):
        half = len(code) // 2
        return code[:half] + " " + code[half:]
    return code


def bar(left, interval):
    filled = round(BAR_WIDTH * left / interval)
    return "█" * filled + "░" * (BAR_WIDTH - filled)


def render_row(row, name_width, now):
    name = row.alias.ljust(name_width)
    if row.error:
        return "%s  ! %s" % (name, row.error)
    if row.code is None:
        return "%s  ..." % name
    left = seconds_left(row, now)
    return "%s  %-9s  %2ds  %s" % (name, format_code(row.code), left, bar(left, row.interval))


def render_frame(rows, now):
    width = max(len(r.alias) for r in rows)
    return "\n".join(render_row(r, width, now) for r in rows)


